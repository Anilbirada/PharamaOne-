# Copy to .env and replace placeholders locally. Never commit .env.
# DATABASE_URL is the non-superuser application role, not the PostgreSQL admin role.
DATABASE_URL=postgresql://pharmaone_app:CHANGE_ME@127.0.0.1:5432/pharmaone_test
# Used only by npm run db:migrate. Keep this credential separate from the app role.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/pharmaone_test
